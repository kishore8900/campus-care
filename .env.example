# Server settings
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Frontend setting (Vite reads only variables beginning with VITE_).
VITE_API_URL=http://localhost:4000
# Generate a long, random value before any deployment.
JWT_SECRET=replace-with-a-long-random-production-secret
# Supabase Postgres connection string for Prisma.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public
# College-owned administrator bootstrap. This is the only way to create an admin;
# public registration always creates STUDENT accounts. Do not commit real credentials.
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Local AI option (recommended for development): install Ollama and pull a model.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:1b
# Cloud option: set AI_PROVIDER=gateway and provide a server-only gateway key.
# AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-key
# AI_MODEL=openai/gpt-5.6-terra
