{
  "name": "campus-care",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b --force && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "api": "node --import tsx server/index.ts",
    "start:local": "node scripts/start-local.mjs",
    "typecheck": "tsc -b --force && tsc -p tsconfig.server.json --noEmit",
    "test:ollama": "node tests/ollama-smoke.mjs",
    "test:knowledge": "node tests/knowledge-smoke.mjs",
    "test:preview": "node tests/preview-smoke.mjs",
    "test:tanglish": "node tests/tanglish-smoke.mjs",
    "test:preview-boundaries": "node tests/preview-boundaries.mjs",
    "test:reply-accuracy": "node tests/reply-accuracy-smoke.mjs",
    "test:admin-access": "node tests/admin-access-smoke.mjs",
    "test": "node node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@prisma/client": "^7.10.0",
    "@vitejs/plugin-react": "latest",
    "ai": "^7.0.92",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.13",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.6.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-axe": "^7.0.0",
    "axe-core": "^4.8.0"
  }
}
